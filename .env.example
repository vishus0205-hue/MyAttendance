# Database connection (PostgreSQL container running on port 5433)
DATABASE_URL="postgresql://postgres:myattendance_password@localhost:5433/myattendance?schema=public"

# AES-256-GCM Encryption Secret (must be a 64-character hex string / 32 bytes)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_ENCRYPTION_SECRET="replace_with_64_char_hex_encryption_secret"

# Webapp Session & Auth Secret
AUTH_SECRET="replace_with_secure_random_auth_secret_key"

# College Portal Integration
PORTAL_URL="https://sdc-sppap1.svkm.ac.in:50001/irj/portal"
PORTAL_ALLOWED_HOSTS="sdc-sppap1.svkm.ac.in"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
